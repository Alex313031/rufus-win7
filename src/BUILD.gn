# Rufus binary, supporting libs, and tests
# https://github.com/pbatard/rufus
# Port of Rufus from make/MSVC to GN/Ninja/LLVM

import("//build/config/win/win.gni")  # use_clang_cl

# Builds all that's needed to make a release
group("rufus_exe") {
  public_deps = [
    ":rufus",
    ":rufus_libs",
  ]
}

# Runtime and compile tests
group("rufus_tests") {
  testonly = true
  public_deps = [
    ":rufus_libs",
  ]
}

# Main rufus app
executable("rufus") {
  # Rufus provides a narrow WinMain() entry point (and fetches wide argv itself
  # via __wgetmainargs), so it must NOT be linked with -municode, which selects
  # the wide wWinMainCRTStartup and then fails to resolve wWinMain. Swap the
  # default :unicode config (which adds -municode) for :unicode_base, keeping
  # UNICODE/_UNICODE and UTF-8 charset handling without the Unicode entry point.
  # (Executables also default to :windowed_subsystem, which :rufus_config re-adds.)
  configs -= [ "//build/config/win:unicode" ]
  configs += [
    "//build/config/win:unicode_base",
    ":rufus_config",
  ]

  sources = [
    #"../res/dbx/dbx_info.h",
    "../res/grub2/grub2_version.h",
    "../res/grub/grub_version.h",
    "badblocks.h",
    "bled/bled.h",
    "cregex.h",
    "darkmode.h",
    "drive.h",
    "efi.h",
    "format.h",
    "gpt_types.h",
    "hdd_vs_ufd.h",
    "mbr_types.h",
    "missing.h",
    #"msvc-missing/unistd.h",
    "ntdll.h",
    "settings.h",
    "libcdio/cdio/cdio.h",
    "libcdio/cdio/iso9660.h",
    "libcdio/cdio/udf.h",
    "localization.h",
    "localization_data.h",
    "msapi_utf8.h",
    "dos.h",
    "registry.h",
    "resource.h",
    "rufus.h",
    "license.h",
    "db.h",
    "smart.h",
    "dev.h",
    "ui.h",
    "ui_data.h",
    "vhd.h",
    "winio.h",
    "wue.h",
    "xml.h",
  ]

  sources += [
    "badblocks.c",
    "cregex_compile.c",
    "cregex_parse.c",
    "cregex_vm.c",
    "darkmode.c",
    "dos_locale.c",
    "drive.c",
    "format.c",
    "dos.c",
    "format_ext.c",
    "format_fat32.c",
    "icon.c",
    "iso.c",
    "localization.c",
    "net.c",
    "parser.c",
    "pki.c",
    "process.c",
    "rufus.c",
    "rufus.rc",
    "hash.c",
    "smart.c",
    "stdfn.c",
    "stdio.c",
    "stdlg.c",
    "syslinux.c",
    "dev.c",
    "ui.c",
    "vhd.c",
    "wue.c",
    "xml.c",
  ]

  deps = [
    "libcdio:libcdio",
    "syslinux:syslinux",
  ]

  public_deps = [
    "bled:bled",
    "ext2fs:ext2fs",
    "getopt:getopt",
    "libcdio:libcdio-driver",
    "libcdio:libcdio-iso9960",
    "libcdio:libcdio-udf",
    "ms-sys:ms-sys",
    "syslinux:syslinux-libfat",
    "syslinux:syslinux-libinstaller",
    "syslinux:syslinux-win",
    "wimlib:wimlib",
  ]
}

# Rufus supporting libraries as a standalone target
group("rufus_libs") {
  public_deps = [
    "bled:bled",
    "ext2fs:ext2fs",
    "getopt:getopt",
    "libcdio:libcdio",
    "libcdio:libcdio-driver",
    "libcdio:libcdio-iso9960",
    "libcdio:libcdio-udf",
    "ms-sys:ms-sys",
    "syslinux:syslinux",
    "syslinux:syslinux-libfat",
    "syslinux:syslinux-libinstaller",
    "syslinux:syslinux-win",
    "wimlib:wimlib",
  ]
}

# Rufus specific configs
config("rufus_config") {
  configs = []
  defines = []
  cflags = []
  cflags_c = []
  ldflags = []
  libs = []
  # Must explicitly set this for sources
  configs += [ "//build/config/win:windowed_subsystem", ]

  if (use_clang_cl) {
    cflags_c = [ "/clang:-std=c23" ]
  } else {
    cflags_c = [ "-std=c23" ]
  }

  include_dirs = [
    "./",
    "../",
    "getopt/",
    "libcdio/",
    "res/",
    "wimlib/",
    #"msvc-missing/",
    "ms-sys/inc/",
    "syslinux/libinstaller/",
    "syslinux/libfat/",
    "syslinux/win/",
  ]

  defines += [
    "_RUFUS",
    "COBJMACROS",
    "_CRTDBG_MAP_ALLOC",
  ]

  cflags_c += [
    "-Wno-gnu-folding-constant",
    "-Wno-deprecated-non-prototype",
    "-Wno-dll-attribute-on-redeclaration",
    "-Wno-pointer-sign",
  ]

  cflags += [
    "-msse2",
    "-msse3",
    "-mssse3",
    "-msha",
    "-Wno-pointer-sign",
  ]

  ldflags += [
    # /BREPRO (reproducible build) in the lld GNU/MinGW driver spelling. The
    # MSVC /DEPENDENTLOADFLAG:0x800 (LOAD_LIBRARY_SEARCH_SYSTEM32) has no lld
    # GNU-driver equivalent, and Rufus already applies it at runtime via
    # SetDefaultDllDirectories(), so it is dropped here rather than converted.
    "-Wl,--no-insert-timestamp",
  ]

  # System import libraries. GN prepends the toolchain lib switch (-l), so these
  # must be bare names, NOT "*.lib" (which would become -lcrypt32.lib and fail
  # to resolve against libcrypt32.a). wimlib is built by this project and linked
  # via the wimlib:wimlib dependency, so it must NOT be listed here.
  libs += [
    # Import libraries from rufus.vcxproj's AdditionalDependencies, minus the
    # ones :windowed_subsystem already provides (kernel32/user32/shell32/comctl32).
    # clang-cl's /Zl (see the toolchain) strips the MSVC autolink directives, so
    # every needed import library must be listed explicitly.
    "advapi32",
    "comdlg32",
    "crypt32",
    "dwmapi",
    "gdi32",
    "ntdll",
    "ole32",
    "setupapi",
    "shlwapi",
    "uuid",
    "uxtheme",
    "version",
    "virtdisk",
    "wininet",
    "wintrust",
  ]
}
